+    def _get_cognitive_cross_tokens(self, cog_feature, dtype):
+        if (
+            not self.use_cognitive_plan_query
+            or self.cog_fusion_stage not in [
+                'diffusion_cross_attn',
+                'diffusion_cross_attn_after_self_attn',
+            ]
+        ):
+            return None
+
+        if cog_feature is None:
+            raise RuntimeError(
+                f"cog_fusion_stage='{self.cog_fusion_stage}' requires video_cog_feature, "
+                "but cog_feature is None."
+            )
+
+        cog_tokens = self.cog_cross_adapter(cog_feature)
+        cog_tokens = cog_tokens.view(cog_feature.shape[0], self.cog_num_tokens, self.embed_dims)
+        if cog_tokens.shape != (cog_feature.shape[0], self.cog_num_tokens, self.embed_dims):
+            raise RuntimeError(
+                "Unexpected cognitive token shape: "
+                f"got {tuple(cog_tokens.shape)}, expected "
+                f"({cog_feature.shape[0]}, {self.cog_num_tokens}, {self.embed_dims})"
+            )
+        return cog_tokens.to(dtype=dtype)
+
+
+    def _fuse_cognitive_diffusion_cross_attn(self, traj_feature, cog_feature, cog_layer_index):
+        if (
+            not self.use_cognitive_plan_query
+            or self.cog_fusion_stage not in [
+                'diffusion_cross_attn',
+                'diffusion_cross_attn_after_self_attn',
+            ]
+        ):
+            return traj_feature
+
+        if self.cog_fusion_type != 'gated_residual':
+            raise ValueError(f'Invalid cog_fusion_type={self.cog_fusion_type}')
+        if traj_feature.dim() != 3:
+            raise ValueError(
+                f"{self.cog_fusion_stage} expects traj_feature [B, M, C], "
+                f"got {tuple(traj_feature.shape)}"
+            )
+        if traj_feature.shape[-1] != self.embed_dims:
+            raise ValueError(
+                f"{self.cog_fusion_stage} traj_feature channel mismatch: "
+                f"got {tuple(traj_feature.shape)}, expected C={self.embed_dims}"
+            )
+        if self.cog_cross_attn_layers is None:
+            raise RuntimeError(
+                f"cog_fusion_stage='{self.cog_fusion_stage}' requires initialized "
+                "cog_cross_attn_layers."
+            )
+        if cog_layer_index < 0 or cog_layer_index >= len(self.cog_cross_attn_layers):
+            raise IndexError(
+                f"{self.cog_fusion_stage} layer index out of range: "
+                f"index={cog_layer_index}, num_layers={len(self.cog_cross_attn_layers)}"
+            )
+
+        cog_tokens = self._get_cognitive_cross_tokens(
+            cog_feature=cog_feature,
+            dtype=traj_feature.dtype,
+        )
+        if cog_tokens.shape[0] != traj_feature.shape[0]:
+            raise ValueError(
+                f"{self.cog_fusion_stage} batch mismatch: "
+                f"traj_feature={tuple(traj_feature.shape)}, cog_tokens={tuple(cog_tokens.shape)}"
+            )
+        if cog_tokens.shape[-1] != traj_feature.shape[-1]:
+            raise ValueError(
+                f"{self.cog_fusion_stage} channel mismatch: "
+                f"traj_feature={tuple(traj_feature.shape)}, cog_tokens={tuple(cog_tokens.shape)}"
+            )
+        cog_out = self.cog_cross_attn_layers[cog_layer_index](
+            traj_feature,
+            key=cog_tokens,
+            value=cog_tokens,
+        )
+        cog_out = self.cog_cross_norm_layers[cog_layer_index](cog_out)
+        gate = torch.sigmoid(self.cog_cross_gate).to(dtype=traj_feature.dtype)
+
+        if self.cog_debug and not hasattr(self, "_debug_cog_cross_attn_printed"):
+            print(
+                f"[CogFusionDebug][{self.cog_fusion_stage}]",
+                "layer_index:",
+                cog_layer_index,
+                "traj_feature:",
+                tuple(traj_feature.shape),
+                "cog_tokens:",
+                tuple(cog_tokens.shape),
+                "cog_out:",
+                tuple(cog_out.shape),
+                "gate:",
+                gate.detach().item(),
+                flush=True,
+            )
+            self._debug_cog_cross_attn_printed = True
+
+        return traj_feature + gate * (cog_out - traj_feature)
+
+
